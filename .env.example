# Konfigurasi LLM Gateway (kompatibel OpenAI SDK)
# Isi kredensial Anda di file .env lokal; jangan commit .env ke Git.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25

# Pengaturan API Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQLITE_DB_PATH=apps/api/storage/telemetry.db

# Pengaturan Frontend Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
